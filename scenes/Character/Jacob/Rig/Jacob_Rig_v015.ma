	setAttr ".codeFragment" -type "string" "Exception as e_getenv:\\n             print(f\"Warning: Could not get username via MEL getenv: {{e_getenv}}\")\\n\\n        if not username:\\n            username = \"MayaUser\" # Fallback username\\n\\n        # 3. Get current date and time using cmds.date()\\n        try:\\n            # Format: YYYYMMDD\\n            date_str = cmds.date(format=\\'YYYYMMDD\\')\\n            # Format: HHMM (24-hour)\\n            time_str = cmds.date(format=\\'hhmm\\')\\n        except Exception as e_date:\\n            print(f\"Warning: Could not get date/time via cmds.date: {{e_date}}\")\\n            date_str = \"DateError\"\\n            time_str = \"TimeError\"\\n\\n        # 4. Construct the filename using available info\\n        #    Clean username just in case it has invalid characters for filename (basic)\\n        safe_username = \"\".join(c for c in username if c.isalnum() or c in (\\'_\\', \\'-\\'))\\n        if not safe_username: safe_username = \"MayaUser\" # Ensure not empty after cleaning\\n\\n        filename = f\"{{safe_user";
