	setAttr ".codeFragment" -type "string" " Crash ---\\n# This function is defined globally within the bootstrap scope so the scriptJob can find it.\\ndef _extract_stage():\\n    _log_bootstrap(\"Extraction stage (_extract_stage) initiated.\")\\n    # Ensure the main node exists before proceeding\\n    if not cmds.objExists(\"codeExtractor\"):\\n        _log_bootstrap(\"Extractor node \\'codeExtractor\\' missing. Aborting extraction.\")\\n        return\\n\\n    # --- Initialize variables for this stage ---\\n    code = \"\"\\n    target_file = None\\n    module_name = None\\n    write_path = None\\n    successful_dir = None # Store the directory where write succeeded\\n    write_successful = False\\n    did_modify_user_setup = False # Flag to track if userSetup.py is modified this run\\n\\n\\n    # 1. Extract metadata and reassemble code from network nodes\\n    _log_bootstrap(\"Extracting metadata and code...\")\\n    # Get metadata from separate attributes (no json)\\n    target_file = cmds.getAttr(\"codeExtractor.targetFileNameAttr\")\\n    module_name = cmds.";
