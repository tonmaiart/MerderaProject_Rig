\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetSkirtC1_R\\\", r=True) or []\\n\\nh += cmds.ls(\\\"*FKOffsetClothDtlAMain_L\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlBMain_L\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlCMain_L\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlDMain_L\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlEMain_L\\\", r=True) or []\\n\\nh += cmds.ls(\\\"*FKOffsetClothDtlAMain_R\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlBMain_R\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlCMain_R\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlDMain_R\\\", r=True) or []\\nh += cmds.ls(\\\"*FKOffsetClothDtlEMain_R\\\", r=True) or []\\n\\n\\nif h:\\n    # if ANY is hidden, turn ALL on. Otherwise turn ALL off.\\n    any_hidden = any(cmds.getAttr(i + \\\".v\\\") == 0 for i in h)\\n    new_v = True if any_hidden else False\\n    for i in h:\\n        cmds.setAttr(i + \\\".v\\\", new_v)\", \"ctrl\": false, \"shift\": false, \"deferred\": false, \"force_compact_undo\": false}], \"action.menu_commands\": [], \"image.path\": \"\", \"image.fit\": true, \"image.ratio\": true, \"image.height\": 32, \"image.width\": 32, \"id\": \"96d84380-4570-4607-82d7-69fcf2002d94\", \"children\": []}, {\"background\": false, \"visibility_layer\": null, \"shape.ignored_by_focus\": false, \"panel\": 0, \"shape\": \"square\", \"shape.space\": \"world\", \"shape.anchor\": \"top_left\", \"shape.path\": [], \"shape.left\": 490.0, \"shape.top\": 440.0, \"shape.width\": 78.42940863079343, \"shape.height\": 43.0, \"shape.cornersx\": 4, \"shape.cornersy\": 4, \"border\": true, \"borderwidth.normal\": 1.0, \"borderwidth.hovered\": 1.25, \"borderwidth.clicked\": 2, \"bordercolor.normal\": \"#000000\", \"bordercolor.hovered\": \"#393939\", \"bordercolor.clicked\": \"#FFFFFF\", \"bordercolor.transparency\": 0, \"bgcolor.normal\": \"#ffffff\", \"bgcolor.hovered\": \"#AAAAAA\", \"bgcolor.clicked\": \"#DDDDDD\", \"bgcolor.transparency\": 